{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-deploy-demo-api",
  "main": "src/main.py",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    // Comma-separated browser origins allowed to call this API.
    "CORS_ORIGINS": "https://cloudflare-deploy-demo-web.mind-technology-lab.workers.dev,http://localhost:3001,http://127.0.0.1:3001,http://localhost:8788,http://127.0.0.1:8788"
  },
  // NOTE_TOKEN is a secret. Set it with `pywrangler secret put NOTE_TOKEN`.
  // Local development reads it from .dev.vars, which is not committed.
  "secrets": {
    "required": ["NOTE_TOKEN"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudflare-deploy-demo",
      "database_id": "89b1d314-af1f-45e1-bbe7-6268042b3703",
      "migrations_dir": "migrations"
    }
  ]
}
