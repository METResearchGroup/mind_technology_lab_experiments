{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-deploy-demo-api",
  "main": "src/main.py",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["python_workers"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    // Comma-separated browser origins allowed to call this API.
    // Add the deployed frontend origin before a production deploy.
    "CORS_ORIGINS": "http://localhost:3001,http://127.0.0.1:3001,http://localhost:8788,http://127.0.0.1:8788"
  },
  // NOTE_TOKEN is a secret. Set it with `pywrangler secret put NOTE_TOKEN`.
  // Local development reads it from .dev.vars, which is not committed.
  "secrets": {
    "required": ["NOTE_TOKEN"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudflare-deploy-demo",
      // Replace this placeholder after `pywrangler d1 create cloudflare-deploy-demo`.
      // Local `migrations apply --local` works with this id. Remote deploy does not.
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ]
}
